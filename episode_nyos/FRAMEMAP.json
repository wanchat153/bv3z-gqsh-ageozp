  },
  {
   "t0": 7.288,
   "t1": 8.717,
   "text": "\u0e2b\u0e21\u0e39\u0e48\u0e1a\u0e49\u0e32\u0e19\u0e19\u0e35\u0e2d\u0e2d\u0e2a \u0e41\u0e04\u0e40\u0e21\u0e2d\u0e23\u0e39\u0e19"
  },
  {
   "t0": 8.817,
   "t1": 9.747,
   "text": "\u0e23\u0e32\u0e27\u0e2a\u0e32\u0e21\u0e17\u0e38\u0e48\u0e21\u0e04\u0e23\u0e36\u0e48\u0e07"
  },
  {
   "t0": 9.747,
   "t1": 11.217,
   "text": "\u0e21\u0e35\u0e40\u0e2a\u0e35\u0e22\u0e07\u0e04\u0e23\u0e37\u0e19\u0e14\u0e31\u0e07\u0e21\u0e32\u0e08\u0e32\u0e01\u0e17\u0e30\u0e40\u0e25\u0e2a\u0e32\u0e1a"
  },
  {
   "t0": 11.317,
   "t1": 12.83,
   "text": "\u0e19\u0e49\u0e33\u0e1e\u0e38\u0e48\u0e07\u0e02\u0e36\u0e49\u0e19\u0e08\u0e32\u0e01\u0e01\u0e25\u0e32\u0e07\u0e17\u0e30\u0e40\u0e25\u0e2a\u0e32\u0e1a"
  },
  {
   "t0": 12.83,
   "t1": 13.717,
   "text": "\u0e2a\u0e39\u0e07\u0e23\u0e32\u0e27 100 \u0e40\u0e21\u0e15\u0e23"
  },
  {
   "t0": 13.817,
   "t1": 14.766,
   "text": "\u0e41\u0e25\u0e49\u0e27\u0e1b\u0e25\u0e48\u0e2d\u0e22\u0e01\u0e4a\u0e32\u0e0b"
  },
  {
   "t0": 14.766,
   "t1": 16.217,
   "text": "\u0e04\u0e32\u0e23\u0e4c\u0e1a\u0e2d\u0e19\u0e44\u0e14\u0e2d\u0e2d\u0e01\u0e44\u0e0b\u0e14\u0e4c\u0e21\u0e2b\u0e32\u0e28\u0e32\u0e25"
  },
  {
